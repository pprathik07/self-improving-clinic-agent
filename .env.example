# LLM Provider (Google Gemini)
GEMINI_API_KEY=your-api-key-here

# Mock mode for testing (set to 0 for real runs with API key)
MOCK_LLM=0

# Models — placeholders only. List real IDs with: uv run python scripts/list_models.py
# In real mode AGENT_MODEL, JUDGE_MODEL, and SIM_MODEL must all be different.
AGENT_MODEL=your-agent-model-id
JUDGE_MODEL=your-judge-model-id
SIM_MODEL=your-sim-model-id
REFLECTOR_MODEL=your-reflector-model-id

# Set REQUIRE_REAL=1 to refuse running when MOCK_LLM=1
# REQUIRE_REAL=0

# Frozen clock for deterministic scheduling (ISO 8601)
FROZEN_NOW=2025-01-13T09:00:00

# Eval config
RUNS_PER_SCENARIO=3
